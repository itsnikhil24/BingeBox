{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",

    "rootDir": ".",
    "outDir": "./dist",

    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,

    "strict": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true
  },

  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}